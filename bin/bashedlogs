#!/usr/bin/env bash
# shellcheck disable=SC2329  # registry functions are invoked indirectly via ${fmt}_analyze
# ******************************************************************************
# *Title: Bashedlogs CLI*
# *Author: Kyle Versluis (@ktalons)*
# *Description: Fast security log triage CLI entry point.*
# ******************************************************************************
# https://github.com/ktalons/bashedlogs

set -euo pipefail

# *--- Configuration ---*

# shellcheck disable=SC2034  # read by lib/core (cli --version, output emitters)
BASHEDLOGS_VERSION="2.0.1"

# *--- Bash Version Guard ---*

# NOTE: runs before anything else so bash 3.2 (stock macOS) gets a clear
# message instead of a parse error from 4.0-only syntax further down.
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  echo "bashedlogs: bash 4.0+ required (found ${BASH_VERSION:-unknown})" >&2
  echo "macOS ships bash 3.2 at /bin/bash; install a modern bash with: brew install bash" >&2
  exit 1
fi

# *--- Library Loading ---*

# @BUNDLE-SKIP-START -- the single-file release artifact inlines lib/ here instead
BASHEDLOGS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for _lib in "$BASHEDLOGS_ROOT"/lib/core/*.sh "$BASHEDLOGS_ROOT"/lib/formats/*.sh; do
  # shellcheck source=/dev/null
  source "$_lib"
done
unset _lib
# @BUNDLE-SKIP-END

# *--- Entry Point ---*

# SECURITY: log text is handled as bytes. In a multibyte locale BSD awk stops
# at the first byte sequence that is invalid there and prints that raw line
# to stderr, and bash expansion can add a byte to one. lib/ has already read
# the caller's locale into PRETTY_LOCALE, so the run itself goes under C.
export LC_ALL=C
# NOTE: ${1+"$@"}, not "$@": with no arguments bash 4.0 calls $@ unbound under
# set -u and dies before main can print usage.
main ${1+"$@"}
